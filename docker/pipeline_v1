name: CI/CD - Sunflower Ecommerce

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

env:
  AWS_REGION: us-east-1                      # Cambia a tu región AWS
  ECR_REPOSITORY: sunflower-app              # Nombre del repositorio en ECR
  EC2_HOST: ${{ secrets.EC2_HOST }}          # IP pública de tu EC2
  APP_PORT: 8081

jobs:
  # ✅ ETAPA 1: Tests + Build JAR
  test-and-build:
    name: 🧪 Test & Build
    runs-on: ubuntu-latest

    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: benja
          MYSQL_DATABASE: ecommerce_db
        ports:
          - 3306:3306
        options: >-
          --health-cmd="mysqladmin ping"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=5

    steps:
      - name: 📥 Checkout código
        uses: actions/checkout@v4

      - name: ☕ Configurar Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: 🧪 Ejecutar tests
        env:
          SPRING_DATASOURCE_URL: jdbc:mysql://localhost:3306/ecommerce_db?serverTimezone=America/Lima&useSSL=false&allowPublicKeyRetrieval=true
          SPRING_DATASOURCE_USERNAME: root
          SPRING_DATASOURCE_PASSWORD: benja
        run: mvn test

      - name: 🔨 Build JAR (sin tests)
        run: mvn package -DskipTests

      - name: 📦 Guardar JAR como artefacto
        uses: actions/upload-artifact@v4
        with:
          name: app-jar
          path: target/*.jar

  # 🐳 ETAPA 2: Docker Build + Push a ECR
  docker-build-push:
    name: 🐳 Docker Build & Push ECR
    runs-on: ubuntu-latest
    needs: test-and-build

    outputs:
      image: ${{ steps.build-image.outputs.image }}

    steps:
      - name: 📥 Checkout código
        uses: actions/checkout@v4

      - name: 📦 Descargar JAR
        uses: actions/download-artifact@v4
        with:
          name: app-jar
          path: target/

      - name: 🔐 Configurar credenciales AWS
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: 🔑 Login a Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: 🏗️ Build, Tag y Push imagen Docker
        id: build-image
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .
          docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:latest .
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:latest
          echo "image=$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" >> $GITHUB_OUTPUT

  # 🚀 ETAPA 3: Deploy en EC2
  deploy:
    name: 🚀 Deploy en AWS EC2
    runs-on: ubuntu-latest
    needs: docker-build-push

    steps:
      - name: 🔐 Configurar credenciales AWS
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: 🔑 Login a Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: 🚀 Deploy en EC2 via SSH
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ubuntu
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            # Login a ECR desde EC2
            aws ecr get-login-password --region ${{ env.AWS_REGION }} | \
              docker login --username AWS --password-stdin \
              ${{ needs.docker-build-push.outputs.image }}

            # Detener contenedores anteriores
            docker rm -f sunflower_web_app || true
            docker rm -f sunflower_db_mysql || true

            # Bajar nueva imagen
            docker pull ${{ needs.docker-build-push.outputs.image }}

            # Levantar con docker-compose
            cd /home/ubuntu/app
            docker-compose -p sunflowerapp down -v --remove-orphans || true
            docker-compose -p sunflowerapp up -d --build

      - name: 🏥 Health Check
        run: |
          echo "⏳ Esperando 30 segundos para que Spring Boot arranque..."
          sleep 30
          COUNTER=1
          while [ $COUNTER -le 15 ]; do
            if curl -f http://${{ secrets.EC2_HOST }}:8081/home > /dev/null 2>&1; then
              echo "✅ ¡La tienda Sunflower está respondiendo!"
              exit 0
            fi
            echo "Intento $COUNTER/15 - reintentando en 5s..."
            COUNTER=$((COUNTER + 1))
            sleep 5
          done
          echo "❌ Health Check falló"
          exit 1
